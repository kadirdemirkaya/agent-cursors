{
  "manifest_version": 3,
  "name": "Ajan İmleçleri",
  "version": "2.0.0",
  "description": "localhost, 127.0.0.1 ve dosya sayfalarına Ajan İmleçleri overlay'ini otomatik ekler. Ajan düzenlemeden önce imleç elemana gelir; değişiklik imleç oradayken yansır.",
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://*.localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://0.0.0.0/*",
        "http://[::1]/*",
        "file:///*"
      ],
      "exclude_matches": [
        "http://127.0.0.1:7373/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://*.localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://0.0.0.0/*",
        "http://[::1]/*",
        "file:///*"
      ],
      "exclude_matches": [
        "http://127.0.0.1:7373/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Ajan İmleçleri",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "111"
}
